# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/fixhub

# Auth (required — use long random strings in production)
SECRET_KEY=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Google OAuth (optional for local email/password only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000

# AI chatbot (optional)
GEMINI_API_KEY=
