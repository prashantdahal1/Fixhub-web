# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/fixhub

# Auth (required — use long random strings in production)
SECRET_KEY=change-me-to-a-long-random-secret
SESSION_SECRET=change-me-to-another-long-random-secret

# Google OAuth (required for mobile Google Sign-In and optional for redirect-based browser OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (password reset)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
FRONTEND_URL=http://localhost:3000

# Payments
# eSewa ePay v2 sandbox defaults are EPAYTEST + the public sandbox secret.
# Override these only when eSewa gives you merchant-specific credentials.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Khalti ePayment v2 (https://docs.khalti.com/khalti-epayment/)
# Get your Sandbox Secret Key from https://test-admin.khalti.com (Keys section)
# Example: KHALTI_SECRET_KEY=live_secret_key_68791341fdd94846a146f0457ff7b455
KHALTI_SANDBOX=true
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# AI chatbot (optional)
GEMINI_API_KEY=
